{
  "name": "@jakerains/scormplayer",
  "version": "0.8.2",
  "description": "Open any SCORM package in your browser, click through it like an LMS would, and leave pinned notes you can hand to a teammate or an AI agent.",
  "keywords": [
    "scorm",
    "scorm-1.2",
    "scorm-2004",
    "elearning",
    "lms",
    "player",
    "review",
    "annotations",
    "cli"
  ],
  "license": "MIT",
  "author": "Jake Rains",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakerains/scormplayer.git"
  },
  "homepage": "https://github.com/jakerains/scormplayer#readme",
  "bugs": "https://github.com/jakerains/scormplayer/issues",
  "type": "module",
  "bin": {
    "scormplayer": "bin/scormplayer.mjs"
  },
  "exports": {
    ".": "./server/index.mjs"
  },
  "files": [
    "bin",
    "server",
    "skills",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/server.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node bin/scormplayer.mjs",
    "prepack": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "html-to-image": "^1.11.13",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
