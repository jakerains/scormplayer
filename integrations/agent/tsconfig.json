{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "allowJs": true
  },
  "include": [
    "index.ts",
    "src/**/*",
    "views/**/*",
    "stdio.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
